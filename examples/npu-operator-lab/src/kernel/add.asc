#include "acl/acl.h"
#include "elementwise_impl.h"
#include "launchers.h"

__global__ __vector__ void nl_add_kernel(__gm__ float* a, __gm__ float* b,
                                         __gm__ float* out, uint32_t n,
                                         uint32_t tiles) {
    ElementwiseKernel<false> kernel;
    kernel.Init(a, b, out, n, tiles);
    kernel.Process();
}

extern "C" void nl_launch_add(uint32_t blocks, void* stream, const void* a,
                               const void* b, void* out,
                               uint32_t n, uint32_t tiles) {
    nl_add_kernel<<<blocks, 0, stream>>>(
        (float*)a, (float*)b, (float*)out, n, tiles);
}
